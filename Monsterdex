<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Monsterdex — Jogo de Mon­stros</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Trebuchet MS','Segoe UI',system-ui,sans-serif;background:#2b2f44;color:#1a1a2e;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:12px}
#app{width:100%;max-width:900px;background:linear-gradient(160deg,#f6f8ff,#e8edff);border:6px solid #30364f;border-radius:22px;box-shadow:0 18px 50px rgba(0,0,0,.45);overflow:hidden;position:relative}
.topbar{display:flex;align-items:center;justify-content:space-between;background:#e63946;color:#fff;padding:10px 16px;border-bottom:5px solid #b5202c}
.topbar .logo{font-weight:900;letter-spacing:1px;font-size:19px;text-shadow:1px 1px 0 #8a1820}
.wallet{background:#fff;color:#b5202c;font-weight:800;padding:5px 12px;border-radius:30px;font-size:14px;box-shadow:inset 0 0 0 2px #ffd166}
.screen{padding:18px;min-height:460px}
.hidden{display:none!important}
h2{color:#30364f;margin-bottom:6px;font-size:22px}
.sub{color:#5a6080;font-size:14px;margin-bottom:14px}
btn,button{font-family:inherit}
.btn{cursor:pointer;border:none;border-radius:12px;padding:11px 16px;font-weight:800;font-size:15px;color:#fff;background:#4361ee;box-shadow:0 4px 0 #2f49bf;transition:.08s;margin:4px}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #2f49bf}
.btn.green{background:#2a9d8f;box-shadow:0 4px 0 #1f756b}
.btn.red{background:#e63946;box-shadow:0 4px 0 #b5202c}
.btn.gold{background:#f4a261;box-shadow:0 4px 0 #c97b36;color:#4a2d10}
.btn.gray{background:#8d99ae;box-shadow:0 4px 0 #656f82}
.btn:disabled{filter:grayscale(.7);opacity:.6;cursor:not-allowed}
.btn.small{padding:7px 11px;font-size:13px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.center{display:flex;flex-direction:column;align-items:center;text-align:center}
.cardgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.mon-card{background:#fff;border:3px solid #30364f;border-radius:16px;padding:10px;text-align:center;cursor:pointer;transition:.1s;position:relative}
.mon-card:hover{transform:translateY(-4px);box-shadow:0 8px 18px rgba(0,0,0,.2)}
.mon-card img{width:92px;height:92px;object-fit:contain;image-rendering:auto}
.mon-card .nm{font-weight:800;color:#30364f;margin-top:4px}
.types{display:flex;gap:4px;justify-content:center;margin-top:5px;flex-wrap:wrap}
.tp{font-size:11px;font-weight:800;color:#fff;padding:2px 9px;border-radius:30px;text-shadow:0 1px 1px rgba(0,0,0,.35)}
.hpbar{height:11px;background:#d9dcec;border-radius:30px;overflow:hidden;margin:5px 0;border:1px solid #b5b9d0}
.hpfill{height:100%;background:linear-gradient(90deg,#2a9d8f,#57cc99);transition:width .4s}
.xpbar{height:7px;background:#d9dcec;border-radius:30px;overflow:hidden;margin:3px 0}
.xpfill{height:100%;background:linear-gradient(90deg,#4361ee,#4cc9f0);transition:width .4s}
.lvl{display:inline-block;background:#30364f;color:#ffd166;font-weight:800;font-size:12px;padding:2px 9px;border-radius:30px}
.mini{font-size:12px;color:#5a6080}
.battle{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.arena{background:linear-gradient(170deg,#bfe3ff,#eaf6ff);border:3px solid #30364f;border-radius:16px;padding:12px}
.arena.enemy{background:linear-gradient(170deg,#ffe0e0,#fff0f0)}
.arena img{width:120px;height:120px;object-fit:contain;display:block;margin:6px auto}
.arena .nm{font-weight:900;color:#30364f;font-size:17px}
.log{background:#30364f;color:#e8edff;border-radius:12px;padding:10px 12px;font-size:13.5px;min-height:52px;margin:10px 0;line-height:1.45}
.panel{background:#fff;border:3px solid #30364f;border-radius:16px;padding:14px;margin-bottom:12px}
.tut-item{display:flex;gap:10px;align-items:flex-start;padding:7px 0;border-bottom:1px dashed #c7cce0}
.tut-item b{color:#4361ee}
.badge{position:absolute;top:6px;right:6px;background:#2a9d8f;color:#fff;font-size:10px;font-weight:800;padding:2px 7px;border-radius:30px}
.overlay{position:absolute;inset:0;background:rgba(20,22,38,.72);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}
.modal{background:#f6f8ff;border:5px solid #30364f;border-radius:18px;padding:18px;max-width:420px;width:100%;text-align:center}
.modal h3{color:#30364f;margin-bottom:8px}
.ball-opt{display:flex;justify-content:space-between;align-items:center;background:#fff;border:2px solid #c7cce0;border-radius:12px;padding:8px 12px;margin:6px 0}
.ball-opt .l{text-align:left}
.ball-opt .l b{color:#30364f}
.nav{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;justify-content:center}
.flash{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#30364f;color:#ffd166;padding:9px 18px;border-radius:30px;font-weight:800;font-size:14px;z-index:60;box-shadow:0 6px 18px rgba(0,0,0,.4);animation:pop .3s}
@keyframes pop{from{transform:translate(-50%,14px);opacity:0}to{transform:translate(-50%,0);opacity:1}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
.shake{animation:shake .3s}
@media(max-width:560px){.battle{grid-template-columns:1fr}.arena img{width:96px;height:96px}}
</style>
</head>
<body>
<div id="app">
  <div class="topbar">
    <div class="row"><div class="logo">◉ MONSTERDEX</div><button class="btn small gray credbtn" onclick="creditsScreen()">Créditos</button></div>
    <div class="row"><div class="vol"><button id="volbtn" onclick="toggleMute()" title="Som">🔊</button><input type="range" min="0" max="100" value="50" oninput="setV(this.value)" aria-label="Volume"></div><div class="wallet" id="wallet">₱ 0</div></div>
  </div>
  <div id="screens"></div>
</div>
<script>
const SPRITES={"Monfire": "data:image/png;base64,", "Namarra": "data:image/png;base64,", "Bonsai": "data:image/png;base64,", "Bestie": "data:image/png;base64,", "Chororoper": "data:image/png;base64,", "Coringa": "data:image/png;base64,", "Sakana": "data:image/png;base64,", "Tartadura": "data:image/png;base64,", "TheBluetooth": "data:image/png;base64,", "Zoodrao": "data:image/png;base64,"};
/* ===== DADOS ===== */
const TYPE_COLOR={Normal:'#9199a6',Fogo:'#f4701f',Agua:'#3c9adf',Grama:'#49a03e',Fada:'#ef8fc5',Fantasma:'#6b55a0',Lutador:'#c23b3b',Sombrio:'#4a4458',Metal:'#8aa0b4',Psiquico:'#f05f8b',Dragao:'#6a52d8'};
const TYPE_EN={Normal:'Normal',Fogo:'Fire',Agua:'Water',Grama:'Grass',Fada:'Fairy',Fantasma:'Ghost',Lutador:'Fighting',Sombrio:'Dark',Metal:'Steel',Psiquico:'Psychic',Dragao:'Dragon'};
// tabela de efetividade: atacante -> {defensor:mult}
const CHART={
 Normal:{Fantasma:0,Metal:.5},
 Fogo:{Grama:2,Metal:2,Agua:.5,Fogo:.5,Dragao:.5},
 Agua:{Fogo:2,Agua:.5,Grama:.5,Dragao:.5},
 Grama:{Agua:2,Grama:.5,Fogo:.5,Metal:.5,Dragao:.5},
 Fada:{Lutador:2,Sombrio:2,Dragao:2,Fogo:.5,Metal:.5},
 Fantasma:{Fantasma:2,Psiquico:2,Sombrio:.5,Normal:0},
 Lutador:{Normal:2,Sombrio:2,Metal:2,Fada:.5,Psiquico:.5,Fantasma:0},
 Sombrio:{Fantasma:2,Psiquico:2,Lutador:.5,Sombrio:.5,Fada:.5},
 Metal:{Fada:2,Fogo:.5,Agua:.5,Metal:.5},
 Psiquico:{Lutador:2,Psiquico:.5,Sombrio:0,Metal:.5},
 Dragao:{Dragao:2,Metal:.5,Fada:0}
};
function eff(atk,defTypes){let m=1;defTypes.forEach(d=>{const c=CHART[atk]&&CHART[atk][d];if(c!==undefined)m*=c;});return m;}
// espécies
const DEX=[
 {id:'Monfire',sprite:'Monfire',types:['Fogo'],base:{hp:45,atk:52,def:43},starter:true},
 {id:'Namarra',sprite:'Namarra',types:['Agua'],base:{hp:48,atk:48,def:46},starter:true},
 {id:'Bonsai',sprite:'Bonsai',types:['Grama'],base:{hp:50,atk:46,def:50},starter:true},
 {id:'Bestie',sprite:'Bestie',types:['Normal','Fada'],base:{hp:55,atk:45,def:48}},
 {id:'Chororoper',sprite:'Chororoper',types:['Fantasma'],base:{hp:42,atk:58,def:40}},
 {id:'Coringa',sprite:'Coringa',types:['Lutador'],base:{hp:52,atk:60,def:44}},
 {id:'Sakana',sprite:'Sakana',types:['Sombrio'],base:{hp:46,atk:56,def:42}},
 {id:'Tartadura',sprite:'Tartadura',types:['Metal'],base:{hp:60,atk:44,def:62}},
 {id:'TheBluetooth',name:'The Bluetooth',sprite:'TheBluetooth',types:['Psiquico'],base:{hp:48,atk:62,def:44}},
 {id:'Zoodrao',name:'Zoodrão',sprite:'Zoodrao',types:['Dragao'],base:{hp:58,atk:60,def:52}}
];
function specName(s){return s.name||s.id;}
function findSpec(id){return DEX.find(d=>d.id===id);}
// golpes por tipo
const MOVE_NAME={Normal:'Investida',Fogo:'Lança-chamas',Agua:'Jato d’Água',Grama:'Folha Navalha',Fada:'Brilho Magico',Fantasma:'Bola Sombria',Lutador:'Golpe Duplo',Sombrio:'Mordida Sombria',Metal:'Garra de Aço',Psiquico:'Confusão',Dragao:'Garra de Dragão'};
function movesFor(spec){const mv=spec.types.map(t=>({name:MOVE_NAME[t],type:t,power:38}));mv.push({name:'Investida',type:'Normal',power:30});return mv;}
/* ===== ESTADO ===== */
let G={party:[],storage:[],money:0,defeats:0,trainerLevel:1,caught:[],tutorialDone:false};
function save(){try{localStorage.setItem('monsterdex',JSON.stringify(G));}catch(e){}}
function load(){try{const d=localStorage.getItem('monsterdex');if(d){G=JSON.parse(d);return true;}}catch(e){}return false;}
let uid=1;
function maxHp(spec,lvl){return Math.floor(spec.base.hp*2*lvl/20)+lvl+10;}
function xpNeeded(lvl){return 14+lvl*8;}
function makeMon(specId,lvl){const spec=findSpec(specId);const mh=maxHp(spec,lvl);return{uid:uid++,id:specId,lvl:lvl,xp:0,hp:mh,maxHp:mh};}
function recalcHp(m){const spec=findSpec(m.id);const mh=maxHp(spec,m.lvl);const ratio=m.hp/m.maxHp;m.maxHp=mh;m.hp=Math.max(1,Math.round(mh*ratio));}
/* ===== DOM ===== */
const screens=document.getElementById('screens');
function el(html){const d=document.createElement('div');d.innerHTML=html.trim();return d.firstElementChild;}
function typeBadges(types){return types.map(t=>`<span class="tp" style="background:${TYPE_COLOR[t]}">${t}</span>`).join('');}
function img(spec){return `<img src="${SPRITES[spec.sprite]||''}" alt="${specName(spec)}">`;}
function updateWallet(){document.getElementById('wallet').textContent='₱ '+G.money;}
let flashT;
function flash(msg){const old=document.querySelector('.flash');if(old)old.remove();const f=el(`<div class="flash">${msg}</div>`);document.getElementById('app').appendChild(f);clearTimeout(flashT);flashT=setTimeout(()=>f.remove(),2200);}
function clearOverlay(){document.querySelectorAll('.overlay').forEach(o=>o.remove());}
function overlay(innerHtml){clearOverlay();const o=el(`<div class="overlay">${innerHtml}</div>`);document.getElementById('app').appendChild(o);return o;}
function setScreen(html){clearOverlay();screens.innerHTML='';screens.appendChild(el(`<div class="screen">${html}</div>`));}
/* ===== TELA INICIAL ===== */
function titleScreen(){
 const hasSave=!!localStorage.getItem('monsterdex');
 setScreen(`<div class="center" style="padding-top:40px">
   <h2 style="font-size:30px">◉ MONSTERDEX</h2>
   <p class="sub">Um jogo de captura e batalha de mon­stros. Escolha seu inicial, treine, capture e complete a Monsterdex!</p>
   <div style="font-size:72px;margin:10px">⚡</div>
   <button class="btn green" onclick="startNew()">Novo Jogo</button>
   ${hasSave?'<button class="btn gold" onclick="continueGame()">Continuar</button>':''}
 </div>`);
}
function continueGame(){if(load()){const all=G.party.concat(G.storage);all.forEach(m=>{if(m.uid>=uid)uid=m.uid+1;});updateWallet();hubScreen();}else titleScreen();}
function startNew(){localStorage.removeItem('monsterdex');G={party:[],storage:[],money:300,defeats:0,trainerLevel:1,caught:[],tutorialDone:false};updateWallet();chooseStarter();}
/* ===== ESCOLHA DO INICIAL ===== */
function chooseStarter(){
 const starters=DEX.filter(d=>d.starter);
 setScreen(`<h2>Escolha seu Mon­stro Inicial</h2><p class="sub">Esta será a primeira cria­tura do seu time. Escolha com sabedoria!</p>
  <div class="cardgrid">${starters.map(s=>`
   <div class="mon-card" onclick="pickStarter('${s.id}')">
     ${img(s)}<div class="nm">${specName(s)}</div>
     <div class="types">${typeBadges(s.types)}</div>
   </div>`).join('')}</div>`);
}
function pickStarter(id){
 const m=makeMon(id,1);G.party=[m];G.caught=[id];save();
 const spec=findSpec(id);
 overlay(`<div class="modal"><h3>Ótima escolha!</h3>${img(spec)}<p>Você escolheu <b>${specName(spec)}</b> (${spec.types.join(' / ')})!</p><button class="btn green" onclick="tutorial()">Continuar</button></div>`);
}
/* ===== TUTORIAL ===== */
function tutorial(){
 clearOverlay();
 const items=[
  ['Nome do Mon­stro','O nome da sua cria­tura, mostrado no topo do card.'],
  ['Vida (HP)','A barra verde. Quando chega a zero, o mon­stro desmaia. Recupere na área de Cuidados.'],
  ['Tipagem','A cor/tipo (Fogo, Água, Grama...). Define for­talezas e fraquezas em batalha.'],
  ['Experiência / XP','A barra azul. Vencer batalhas enche a XP; ao encher, o mon­stro sobe de nível (até o 20).'],
  ['Trocar de Mon­stro','Em batalha você pode trocar por outro do seu time ativo.'],
  ['Ataques','Cada mon­stro tem golpes. Alguns são super eficazes dependendo do tipo adversário.'],
  ['Monsterdex','Sua enciclopédia: mostra os sprites de tudo que você já capturou.'],
  ['Armazenamento','Guarda mon­stros ilimitados. Você leva só 6 no time ativo e organiza aqui.'],
  ['Cuidados Mon­stro','Alimente, dê banho e faça carinho para recuperar a vida das suas cria­turas.']
 ];
 setScreen(`<h2>Mini Tutorial — Entenda os Dados</h2><p class="sub">Leia rapidinho antes da sua primeira batalha.</p>
  <div class="panel">${items.map((it,i)=>`<div class="tut-item"><b>${i+1}.</b><div><b>${it[0]}</b><br><span class="mini">${it[1]}</span></div></div>`).join('')}</div>
  <div class="center"><button class="btn red" onclick="startTutorialBattle()">Iniciar Batalha Tutorial ⚔️</button></div>`);
}
/* ===== BATALHA ===== */
let B=null;
function statVal(spec,key,lvl){return Math.floor(spec.base[key]*2*lvl/20)+5;}
function calcDamage(att,def,move){
 const as=findSpec(att.id),ds=findSpec(def.id);
 const a=statVal(as,'atk',att.lvl),d=statVal(ds,'def',def.lvl);
 const e=eff(move.type,ds.types);
 const stab=as.types.includes(move.type)?1.5:1;
 let dmg=Math.floor(((2*att.lvl/5+2)*move.power*a/d)/25+2);
 dmg=Math.floor(dmg*e*stab*(0.85+Math.random()*0.15));
 return{dmg:Math.max(1,dmg),e};
}
function logMsg(t){const l=document.getElementById('battlelog');if(l)l.innerHTML=t;}
function encounterLevel(){
 const base=G.party[0]?G.party[0].lvl:1;
 // mais forte = menos comum
 let r=Math.random();let delta;
 if(r<0.55)delta=Math.floor(Math.random()*3)-2; // perto/abaixo
 else if(r<0.85)delta=Math.floor(Math.random()*2)+1; // um pouco acima
 else delta=Math.floor(Math.random()*4)+3; // bem acima (raro)
 return Math.min(20,Math.max(1,base+delta));
}
function startTutorialBattle(){
 const enemy=makeMon('Bestie',1);
 B={pIdx:0,enemy,isTutorial:true,over:false,busy:false,captured:false};
 renderBattle('Um <b>Bestie</b> selvagem apareceu! Use um ataque para derrotá-lo.');
}
function startRandomBattle(){
 const alive=G.party.find(m=>m.hp>0);
 if(!alive){overlay(`<div class="modal"><h3>Time esgotado!</h3><p>Todos os seus mon­stros desmaiaram. Vá aos Cuidados para recuperar a vida.</p><button class="btn green" onclick="careScreen()">Ir aos Cuidados</button></div>`);return;}
 const spec=DEX[Math.floor(Math.random()*DEX.length)];
 const enemy=makeMon(spec.id,encounterLevel());
 B={pIdx:G.party.indexOf(alive),enemy,isTutorial:false,over:false,busy:false,captured:false};
 renderBattle(`Um <b>${specName(spec)}</b> selvagem (Nv.${enemy.lvl}) apareceu!`);
}
function curP(){return G.party[B.pIdx];}
function monArena(m,side){
 const spec=findSpec(m.id);const hp=Math.round(m.hp/m.maxHp*100);
 return `<div class="arena ${side}" id="arena-${side}">
   <div class="row" style="justify-content:space-between"><span class="nm">${specName(spec)}</span><span class="lvl">Nv.${m.lvl}</span></div>
   <div class="types">${typeBadges(spec.types)}</div>
   ${img(spec)}
   <div class="mini">HP ${m.hp}/${m.maxHp}</div>
   <div class="hpbar"><div class="hpfill" id="hp-${side}" style="width:${hp}%"></div></div>
   ${side==='player'?`<div class="mini">XP ${m.xp}/${xpNeeded(m.lvl)}</div><div class="xpbar"><div class="xpfill" style="width:${Math.round(m.xp/xpNeeded(m.lvl)*100)}%"></div></div>`:''}
 </div>`;
}
function renderBattle(msg){
 const p=curP(),e=B.enemy;
 setScreen(`<div class="battle">${monArena(e,'enemy')}${monArena(p,'player')}</div>
  <div class="log" id="battlelog">${msg}</div>
  <div class="row" id="actions">
    <button class="btn" onclick="showMoves()">⚔️ Atacar</button>
    <button class="btn gray" onclick="openSwitch()" ${G.party.length<2?'disabled':''}>🔄 Trocar</button>
    <button class="btn red" onclick="openCapture()" ${B.isTutorial?'disabled':''}>🎯 Capturar</button>
    <button class="btn gray" onclick="fleeBattle()" ${B.isTutorial?'disabled':''}>🏃 Fugir</button>
  </div>`);
}
function showMoves(){
 const p=curP();const moves=movesFor(findSpec(p.id));
 const a=document.getElementById('actions');
 a.innerHTML=moves.map((mv,i)=>`<button class="btn small" style="background:${TYPE_COLOR[mv.type]};box-shadow:0 4px 0 rgba(0,0,0,.25)" onclick="playerAttack(${i})">${mv.name}<br><span style="font-size:10px;opacity:.9">${mv.type}</span></button>`).join('')+`<button class="btn gray small" onclick="renderBackActions()">← Voltar</button>`;
}
function renderBackActions(){renderBattle(document.getElementById('battlelog').innerHTML);}
function setHp(side,m){const b=document.getElementById('hp-'+side);if(b)b.style.width=Math.max(0,Math.round(m.hp/m.maxHp*100))+'%';}
function effTxt(e){if(e===0)return' Não teve efeito...';if(e>=2)return' Super eficaz!';if(e>0&&e<1)return' Pouco eficaz...';return'';}
function shakeSide(side){const a=document.getElementById('arena-'+side);if(a){a.classList.add('shake');setTimeout(()=>a.classList.remove('shake'),320);}}
function playerAttack(i){
 if(B.busy||B.over)return;B.busy=true;
 const p=curP(),e=B.enemy;const mv=movesFor(findSpec(p.id))[i];
 const r=calcDamage(p,e,mv);e.hp=Math.max(0,e.hp-r.dmg);setHp('enemy',e);shakeSide('enemy');
 logMsg(`${specName(findSpec(p.id))} usou <b>${mv.name}</b>! Causou ${r.dmg} de dano.${effTxt(r.e)}`);
 renderBattle(document.getElementById('battlelog').innerHTML);
 if(e.hp<=0){setTimeout(winBattle,650);return;}
 setTimeout(enemyTurn,750);
}
function enemyTurn(){
 const p=curP(),e=B.enemy;const mv=movesFor(findSpec(e.id))[Math.floor(Math.random()*movesFor(findSpec(e.id)).length)];
 const r=calcDamage(e,p,mv);p.hp=Math.max(0,p.hp-r.dmg);setHp('player',p);shakeSide('player');
 logMsg(`Adversário ${specName(findSpec(e.id))} usou <b>${mv.name}</b>! Causou ${r.dmg} de dano.${effTxt(r.e)}`);
 B.busy=false;
 if(p.hp<=0){setTimeout(playerFainted,650);}
}
function playerFainted(){
 const p=curP();logMsg(`<b>${specName(findSpec(p.id))}</b> desmaiou!`);
 const next=G.party.find(m=>m.hp>0);
 if(next){setTimeout(()=>{B.pIdx=G.party.indexOf(next);renderBattle(`Você enviou <b>${specName(findSpec(next.id))}</b>!`);},700);}
 else{B.over=true;setTimeout(loseBattle,700);}
}
function loseBattle(){
 overlay(`<div class="modal"><h3>Você foi derrotado...</h3><p>Todos os seus mon­stros desmaiaram. Recupere a vida na área de Cuidados.</p><button class="btn green" onclick="careScreen()">Cuidados Mon­stro</button><button class="btn gray" onclick="hubScreen()">Menu</button></div>`);
}
function winBattle(){
 B.over=true;
 const p=curP(),e=B.enemy;
 const lvlDiff=e.lvl-p.lvl;
 let xpGain=Math.round((12+e.lvl*4)*(1+Math.max(0,lvlDiff)*0.3));
 let money=Math.round(20+e.lvl*8+Math.max(0,lvlDiff)*6);
 G.money+=money;updateWallet();
 G.defeats++;
 let msgs=[`Você derrotou <b>${specName(findSpec(e.id))}</b>!`,`+${xpGain} XP e +₱${money}.`];
 // ganho de xp e level up do mon­stro
 p.xp+=xpGain;let leveled=[];
