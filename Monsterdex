 for(let x=0;x<240;x+=4)R(x,86-Math.round(8+7*Math.sin(x/25)),4,50,'#2f5d50');for(let x=0;x<240;x+=4)R(x,104-Math.round(4*Math.sin(x/12)),4,30,'#1f3f38');});
document.head.appendChild(Object.assign(document.createElement('style'),{textContent:Object.keys(BG).map(k=>`.bg-${k}{background-image:url(${BG[k]})}`).join('')}));

/* ---- Áudio ---- */
const AU={ctx:null,vol:.5,muted:false,theme:null,want:'menu',iv:null,step:0};
function ac(){if(!AU.ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;AU.ctx=new C();AU.g=AU.ctx.createGain();AU.g.connect(AU.ctx.destination);setVol();}if(AU.ctx.state==='suspended')AU.ctx.resume();return AU.ctx;}
function setVol(){if(AU.g)AU.g.gain.value=AU.muted?0:AU.vol*.6;const b=document.getElementById('volbtn');if(b)b.textContent=(AU.muted||AU.vol==0)?'🔇':AU.vol<.5?'🔉':'🔊';}
function toggleMute(){AU.muted=!AU.muted;setVol();}
function setV(v){AU.vol=v/100;AU.muted=false;setVol();}
function tone(f,t,d,ty,v){const c=AU.ctx,o=c.createOscillator(),g=c.createGain();o.type=ty;o.frequency.value=f;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v,t+.01);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(AU.g);o.start(t);o.stop(t+d+.05);}
function sweep(a,b,t,d){const o=AU.ctx.createOscillator(),g=AU.ctx.createGain();o.type='square';o.frequency.setValueAtTime(a,t);o.frequency.exponentialRampToValueAtTime(b,t+d);g.gain.setValueAtTime(.18,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(AU.g);o.start(t);o.stop(t+d+.05);}
const MUS={
 menu:{bpm:120,w:'square',m:[0,4,7,4,9,7,4,2,0,4,7,12,9,7,5,4],b:[-12,-12,-7,-5]},
 forest:{bpm:132,w:'square',m:[7,null,7,9,12,null,9,7,5,null,5,7,9,null,4,2],b:[-12,-5,-8,-5]},
 shop:{bpm:140,w:'triangle',m:[0,4,0,4,7,null,7,4,2,5,2,5,9,null,7,null],b:[-12,-12,-10,-7]},
 care:{bpm:80,w:'sine',m:[0,null,4,null,7,null,12,null,9,null,7,null,4,null,2,null],b:[-12,-8,-5,-8]},
 dex:{bpm:150,w:'square',m:[0,0,12,0,0,12,0,10,0,0,12,0,0,15,12,10],b:[-24,-24,-22,-19]},
 farm:{bpm:110,w:'triangle',m:[0,4,7,null,7,9,7,null,5,5,9,null,7,4,2,null],b:[-12,-5,-12,-5]}};
function music(t){AU.want=t;if(!AU.ctx||AU.theme===t)return;AU.theme=t;clearInterval(AU.iv);AU.step=0;const M=MUS[t];if(!M)return;
 AU.iv=setInterval(()=>{if(AU.ctx.state!=='running')return;const s=AU.step++,n=M.m[s%16],now=AU.ctx.currentTime;
  if(n!==null)tone(261.63*Math.pow(2,n/12),now,.22,M.w,.13);if(s%4===0)tone(261.63*Math.pow(2,M.b[(s>>2)%4]/12),now,.5,'triangle',.12);},60000/M.bpm/2);}
document.addEventListener('pointerdown',()=>{ac();music(AU.want);},{once:true});
function sfx(n){if(!ac())return;const t=AU.ctx.currentTime;
 if(n==='throw')sweep(300,900,t,.35);else if(n==='open')sweep(1200,300,t,.3);else if(n==='tick')tone(700,t,.08,'square',.22);
 else if(n==='pop')sweep(600,100,t,.3);else if(n==='click')tone(1500,t,.06,'square',.28);
 else if(n==='ok')[523,659,784,1047,784,1047].forEach((f,i)=>tone(f,t+i*.12,.22,'square',.2));}

/* ---- Telas e temas ---- */
let CUR='menu';
function setScreen(html){clearOverlay();screens.innerHTML='';screens.appendChild(el(`<div class="screen bg-${CUR}">${html}</div>`));music(CUR);}
function creditsScreen(){overlay(`<div class="modal" style="max-height:90%;overflow:auto"><h3>Créditos</h3><p><b>Criadores:</b></p><p class="mini" style="line-height:1.7">Beatriz Alves Moreira de Souza - 8202390<br>Maria Clara Gerbelli Tavares Silva - 8207348<br>Thayná Barbosa Bizarria - 8205326<br>Victor Felipe Reis Silva - 8123588<br>Vinicius de Haro Camargo Machado - 8151401</p><p style="margin-top:10px"><b>Inspirações:</b></p><p class="mini" style="line-height:1.7">Pokémon<br>One Piece<br>The Amazing Digital Circus<br>Jujutsu Kaisen<br>Naruto<br>Dragon Ball<br>Avatar: The Last Airbender</p><button class="btn gray" onclick="clearOverlay()">Fechar</button></div>`);}

function titleScreen(){const has=(()=>{try{return !!localStorage.getItem('monsterdex');}catch(e){return false;}})();
 setScreen(`<div class="center" style="padding-top:40px"><h2 style="font-size:30px">◉ MONSTERDEX</h2><p class="sub">Um jogo de captura e batalha de monstros. Escolha seu inicial, treine, capture e complete a Monsterdex!</p><div style="font-size:72px;margin:10px">⚡</div><div><button class="btn green" onclick="startNew()">Novo Jogo</button>${has?'<button class="btn gold" onclick="continueGame()">Continuar</button>':''}</div></div>`);}
function continueGame(){if(load()){G.balls=G.balls||{};G.xpShare=!!G.xpShare;G.party.concat(G.storage).forEach(m=>{if(m.uid>=uid)uid=m.uid+1;});updateWallet();hubScreen();}else titleScreen();}
function startNew(){overlay(`<div class="modal"><h3>⚠️ Atenção!</h3><p>Iniciar um novo jogo vai <b>apagar todo o seu progresso</b>. Deseja continuar?</p><button class="btn red" id="yesb" disabled>Sim (5)</button><button class="btn green" onclick="clearOverlay()">Não</button></div>`);
 let n=5;const y=document.getElementById('yesb');const iv=setInterval(()=>{if(!document.body.contains(y)){clearInterval(iv);return;}n--;if(n<=0){clearInterval(iv);y.disabled=false;y.textContent='Sim';y.onclick=realNew;}else y.textContent='Sim ('+n+')';},1000);}
function realNew(){try{localStorage.removeItem('monsterdex');}catch(e){}G=newG();updateWallet();chooseStarter();}

function hubScreen(){clearOverlay();updateWallet();const prog=G.defeats%5;
 setScreen(`<div class="row" style="justify-content:space-between"><h2>Menu Principal</h2><span class="lvl">Treinador Nv.${G.trainerLevel}</span></div>
 <p class="sub">Vitórias até o próximo nível: ${prog}/5 · Monsterdex: ${G.caught.length}/${DEX.length}</p>
 <div class="nav"><button class="btn red" onclick="startRandomBattle()">⚔️ Luta Aleatória</button><button class="btn green" onclick="careScreen()">🍎 Cuidados Monstro</button><button class="btn" onclick="dexScreen()">📖 Monsterdex</button><button class="btn gold" onclick="storageScreen()">📦 Armazenamento</button><button class="btn" style="background:#2a9d8f;box-shadow:0 4px 0 #1f756b" onclick="shopScreen()">🛒 Loja</button><button class="btn gray" onclick="typesScreen()">🔎 Tipagens</button></div>
 <h2 style="margin-top:16px;font-size:17px">Seu Time Ativo (${G.party.length}/6)</h2>${partyStrip()}`);}

/* ---- Loja ---- */
function shopScreen(){updateWallet();
 setScreen(`<h2>🛒 Loja</h2><p class="sub">Compre bolas antes de capturar. Seu dinheiro: ₱${G.money}</p>
 <div class="panel">${BALLS.map(b=>`<div class="ball-opt"><div class="l"><b style="color:${b.color}">${b.n}</b> · você tem ${G.balls[b.k]||0}<br><span class="mini">${b.desc}</span></div><button class="btn small" ${G.money<b.cost?'disabled':''} onclick="buy('${b.k}')">₱${b.cost}</button></div>`).join('')}
 <div class="ball-opt"><div class="l"><b>⚙️ Máquina de compartilhar XP</b><br><span class="mini">Compra única: o XP da batalha vai para todos do time.</span></div>${G.xpShare?'<span class="ok2">Comprado ✓</span>':`<button class="btn small gold" ${G.money<2000?'disabled':''} onclick="buy('xp')">₱2000</button>`}</div></div>
 <div class="nav"><button class="btn gray" onclick="hubScreen()">← Menu</button></div>`);}
function buy(k){if(k==='xp'){if(G.xpShare||G.money<2000)return;G.money-=2000;G.xpShare=true;flash('Máquina de compartilhar XP comprada!');}
 else{const b=BALLS.find(x=>x.k===k);if(G.money<b.cost)return;G.money-=b.cost;G.balls[k]=(G.balls[k]||0)+1;flash(b.n+' comprada!');}
 sfx('click');save();shopScreen();}

/* ---- Tipagens ---- */
function typesScreen(){const lst=a=>a.length?`<div class="types" style="justify-content:flex-start">${typeBadges(a)}</div>`:'<div class="mini">—</div>';
 setScreen(`<h2>🔎 Consulta de Tipagens</h2><p class="sub">Para cada tipo atacante: contra quem é mais ou menos efetivo.</p>
 <div class="cardgrid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr))">${Object.keys(TYPE_COLOR).map(t=>{const c=CHART[t]||{},g=f=>Object.keys(c).filter(d=>f(c[d]));
  return `<div class="panel" style="margin:0"><span class="tp" style="background:${TYPE_COLOR[t]};font-size:14px">${t}</span><div class="mini" style="margin-top:6px"><b>Mais efetivo contra (x2):</b></div>${lst(g(v=>v>1))}<div class="mini"><b>Menos efetivo contra (x0.5):</b></div>${lst(g(v=>v>0&&v<1))}<div class="mini"><b>Sem efeito contra:</b></div>${lst(g(v=>v===0))}</div>`;}).join('')}</div>
 <div class="nav"><button class="btn gray" onclick="hubScreen()">← Menu</button></div>`);}

/* ---- Batalha: nível, XP, captura ---- */
function encounterLevel(){const base=G.party[0]?G.party[0].lvl:1;let r=Math.random(),d;
 if(r<.55)d=Math.floor(Math.random()*3)-2;else if(r<.85)d=Math.floor(Math.random()*2)+1;else d=Math.floor(Math.random()*4)+3;
 let l=Math.min(20,Math.max(1,base+d));if(G.party.length===1)l=Math.min(l,base);return l;}
function giveXp(m,x){m.xp+=x;let up=false;while(m.lvl<20&&m.xp>=xpNeeded(m.lvl)){m.xp-=xpNeeded(m.lvl);m.lvl++;recalcHp(m);m.hp=m.maxHp;up=true;}if(m.lvl>=20)m.xp=Math.min(m.xp,xpNeeded(20));return up;}
function winBattle(){B.over=true;const p=curP(),e=B.enemy,ld=e.lvl-p.lvl;
 const xp=Math.round((12+e.lvl*4)*(1+Math.max(0,ld)*.3)),money=Math.round(20+e.lvl*8+Math.max(0,ld)*6);
 G.money+=money;updateWallet();G.defeats++;
 const msgs=[`Você derrotou <b>${specName(findSpec(e.id))}</b>!`,`+${xp} XP e +₱${money}.${G.xpShare?' (XP compartilhado com o time)':''}`];
 (G.xpShare?G.party:[p]).forEach(m=>{if(giveXp(m,xp))msgs.push(`<b>${specName(findSpec(m.id))}</b> subiu para o Nv.${m.lvl}!`);});
 if(G.defeats%5===0){G.trainerLevel++;msgs.push(`🎖️ Você subiu para <b>Treinador Nv.${G.trainerLevel}</b>! (5 vitórias)`);}
 save();
 if(B.isTutorial){G.tutorialDone=true;save();overlay(`<div class="modal"><h3>Batalha vencida! 🎉</h3><p>${msgs.join('<br>')}</p><p class="mini">Tutorial concluído! Visite a Loja para comprar bolas de captura.</p><button class="btn green" onclick="hubScreen()">Continuar</button></div>`);return;}
 overlay(`<div class="modal"><h3>Vitória! 🎉</h3><p>${msgs.join('<br>')}</p><p class="mini">Vitórias para o próximo nível de treinador: ${G.defeats%5}/5</p><button class="btn red" onclick="startRandomBattle()">Outra Luta</button><button class="btn green" onclick="careScreen()">Cuidados</button><button class="btn gray" onclick="hubScreen()">Menu</button></div>`);}
function openCapture(){if(B.over||B.busy)return;const e=B.enemy,own=BALLS.filter(b=>(G.balls[b.k]||0)>0);
 overlay(`<div class="modal"><h3>🎯 Capturar ${specName(findSpec(e.id))}</h3><p class="mini">Quanto menos vida o monstro tiver, maior a chance.</p>${own.length?own.map(b=>`<div class="ball-opt"><div class="l"><b style="color:${b.color}">${b.n}</b> ×${G.balls[b.k]}<br><span class="mini">Chance atual: ${Math.round(chanceOf(b,e)*100)}%</span></div><button class="btn small" onclick="throwBall('${b.k}')">Usar</button></div>`).join(''):'<p>Você não tem nenhuma bola! Compre na 🛒 Loja (Menu).</p>'}<button class="btn gray" onclick="clearOverlay()">Cancelar</button></div>`);}
function catchAnim(color,ok,cb){const app=document.getElementById('app'),ar=document.getElementById('arena-enemy'),im=ar.querySelector('img'),ap=app.getBoundingClientRect(),r=ar.getBoundingClientRect();
 const b=el(`<div class="ballfx" style="--c:${color};left:${r.left-ap.left+r.width/2-18}px;top:${r.top-ap.top+r.height/2-18}px"></div>`);app.appendChild(b);
 sfx('throw');b.animate([{transform:'translate(-260px,240px) rotate(0)'},{transform:'translate(0,-30px) rotate(540deg)',offset:.7},{transform:'translate(0,0) rotate(720deg)'}],{duration:650,easing:'ease-out'});
 setTimeout(()=>{sfx('open');im.style.transition='.35s';im.style.transform='scale(0)';im.style.filter='brightness(6)';},650);
 const w=ok?3:1+Math.floor(Math.random()*3);
 for(let i=0;i<w;i++)setTimeout(()=>{sfx('tick');b.animate([{transform:'rotate(0)'},{transform:'rotate(-28deg)'},{transform:'rotate(28deg)'},{transform:'rotate(0)'}],{duration:600});},1100+i*750);
 setTimeout(()=>{if(ok){sfx('ok');for(let i=0;i<8;i++){const s=el('<div style="position:absolute;z-index:71;font-size:18px;pointer-events:none">⭐</div>');s.style.left=b.style.left;s.style.top=b.style.top;app.appendChild(s);const a=i*Math.PI/4;s.animate([{transform:'translate(0,0)',opacity:1},{transform:`translate(${Math.cos(a)*55}px,${Math.sin(a)*55}px)`,opacity:0}],{duration:900}).onfinish=()=>s.remove();}
  setTimeout(()=>{b.remove();cb();},1300);}
  else{sfx('pop');b.animate([{opacity:1,transform:'scale(1)'},{opacity:0,transform:'scale(1.8)'}],{duration:300,fill:'forwards'});im.style.transform='scale(1)';im.style.filter='none';setTimeout(()=>{b.remove();cb();},400);}},1100+w*750+150);}
function throwBall(k){const b=BALLS.find(x=>x.k===k);if(!(G.balls[k]>0)||B.busy||B.over)return;
 G.balls[k]--;save();clearOverlay();B.busy=true;const e=B.enemy,spec=findSpec(e.id),ok=Math.random()<chanceOf(b,e);
 catchAnim(b.color,ok,()=>{
  if(ok){B.over=true;const mon={uid:uid++,id:e.id,lvl:e.lvl,xp:0,maxHp:e.maxHp,hp:e.maxHp};let where;
   if(G.party.length<6){G.party.push(mon);where='time ativo';}else{G.storage.push(mon);where='Armazenamento';}
   const first=!G.caught.includes(e.id);if(first)G.caught.push(e.id);save();
   overlay(`<div class="modal"><h3>Gotcha! 🎊</h3>${img(spec)}<p><b>${specName(spec)}</b> (Nv.${e.lvl}) foi capturado com a ${b.n}!</p><p class="mini">Enviado para: ${where}.${first?' Novo registro na Monsterdex!':''}</p><button class="btn red" onclick="startRandomBattle()">Outra Luta</button><button class="btn gray" onclick="hubScreen()">Menu</button></div>`);
   if(G.caught.length>=DEX.length&&first)setTimeout(dexComplete,2500);
  }else{flash(`A ${b.n} falhou! O monstro escapou.`);renderBattle(`A ${b.n} não segurou <b>${specName(spec)}</b>! Ele contra-atacou...`);B.busy=true;setTimeout(enemyTurn,700);}});}

/* ---- Cuidados (arrastar) ---- */
let careKind=null;
function careStrip(){return `<div class="cardgrid">${G.party.map(m=>{const s=findSpec(m.id);return `<div class="mon-card" data-uid="${m.uid}" style="cursor:default">${img(s)}<div class="nm">${specName(s)}</div><span class="lvl">Nv.${m.lvl}</span><div class="pref">Prefere: ${ICON[PREF[m.id]]||''} ${PREF[m.id]||''}</div><div class="hpbar"><div class="hpfill" style="width:${Math.round(m.hp/m.maxHp*100)}%"></div></div><div class="mini">HP ${m.hp}/${m.maxHp}</div></div>`;}).join('')}</div>`;}
function careScreen(){clearOverlay();careKind=null;
 setScreen(`<h2>🍎 Cuidados Monstro</h2><p class="sub">Escolha uma ação e arraste o item até o monstrinho. A preferência dele cura mais!</p>
 <div class="row"><button class="btn green" onclick="careAct('comida')">🍖 Dar Comida</button><button class="btn" onclick="careAct('banho')">🛁 Dar Banho</button><button class="btn gold" onclick="careAct('carinho')">💖 Fazer Carinho</button></div>
 <div id="tray" class="center" style="min-height:96px;margin:8px 0"></div>
 <div id="careparty">${careStrip()}</div>
 <div class="nav"><button class="btn gold" onclick="storageScreen()">📦 Armazenamento</button><button class="btn red" onclick="startRandomBattle()">⚔️ Luta Aleatória</button><button class="btn gray" onclick="hubScreen()">← Menu</button></div>`);}
function careAct(kind){careKind=kind;const t=document.getElementById('tray');t.innerHTML=`<div class="mini" style="background:rgba(255,255,255,.88);padding:2px 8px;border-radius:8px;margin-bottom:4px">Arraste até o monstrinho:</div><div id="dragitem" class="dragitem">${ICON[kind]}</div>`;
 const d=document.getElementById('dragitem');
 d.onpointerdown=ev=>{ev.preventDefault();d.setPointerCapture(ev.pointerId);const r=d.getBoundingClientRect(),ox=ev.clientX-r.left,oy=ev.clientY-r.top;
  const mv=e=>{d.style.left=(e.clientX-ox)+'px';d.style.top=(e.clientY-oy)+'px';};d.style.position='fixed';d.style.zIndex=90;mv(ev);d.onpointermove=mv;
  d.onpointerup=e=>{d.onpointermove=d.onpointerup=null;d.style.visibility='hidden';const x=document.elementFromPoint(e.clientX,e.clientY);d.style.visibility='';d.style.position=d.style.left=d.style.top=d.style.zIndex='';const c=x&&x.closest('[data-uid]');if(c)careApply(+c.dataset.uid,careKind);};};}
function hearts(card){for(let i=0;i<9;i++){const h=document.createElement('span');h.textContent='❤️';h.style.cssText=`position:absolute;left:${15+Math.random()*70}%;top:45%;font-size:20px;z-index:80;pointer-events:none;opacity:0`;card.appendChild(h);
 h.animate([{transform:'translateY(0) scale(.5)',opacity:0},{opacity:1,offset:.2},{transform:`translateY(-${70+Math.random()*50}px) scale(1.2)`,opacity:0}],{duration:1400,delay:i*110}).onfinish=()=>h.remove();}}
function careApply(u,kind){const m=G.party.find(x=>x.uid===u);if(!m)return;
 if(m.hp>=m.maxHp){flash(`${specName(findSpec(m.id))} já está com a vida cheia!`);return;}
 const liked=PREF[m.id]===kind;m.hp=Math.min(m.maxHp,m.hp+Math.round(m.maxHp*(liked?.5:.2)));save();sfx('click');
 document.getElementById('careparty').innerHTML=careStrip();const c=document.querySelector(`[data-uid="${u}"]`);
 if(c){c.animate([{transform:'scale(1)'},{transform:'scale(1.08)'},{transform:'scale(1)'}],{duration:350});if(m.hp>=m.maxHp)hearts(c);}
 flash(liked?`${specName(findSpec(m.id))} adorou! 💖 (cura maior)`:`${specName(findSpec(m.id))} gostou, mas preferia ${PREF[m.id]}.`);}

/* ---- Monsterdex / secreto ---- */
function dexScreen(){clearOverlay();const done=G.caught.length>=DEX.length;
 const card=(s,got,n)=>`<div class="mon-card" style="${got?'':'background:#e4e7f3'}">${got?img(s):'<div style="width:92px;height:92px;margin:auto;display:flex;align-items:center;justify-content:center;font-size:40px;color:#b5b9d0">?</div>'}<div class="nm">${got?specName(s):'???'}</div><div class="types">${got?typeBadges(s.types):'<span class="tp" style="background:#b5b9d0">?</span>'}</div><div class="mini">Nº ${String(n).padStart(2,'0')}</div>${got?'<span class="badge">capturado</span>':''}</div>`;
 setScreen(`<h2>📖 Monsterdex</h2><p class="sub">Registro: ${G.caught.length}/${DEX.length} monstros capturados.</p>
 <div class="cardgrid">${DEX.map((s,i)=>card(s,G.caught.includes(s.id),i+1)).join('')}${hasU()?card(SECRET,true,11):''}</div>
 <div class="nav">${done?'<button class="btn green" onclick="dexComplete()">🎉 Parabéns</button><button class="btn gold" onclick="secretMon()">???</button>':''}<button class="btn gray" onclick="hubScreen()">← Menu</button></div>`);}
function secretMon(){if(hasU()){overlay(`<div class="modal"><h3>Você já tem o Uhcakip!</h3>${img(SECRET)}<p class="mini">Só é possível ter um.</p><button class="btn gray" onclick="clearOverlay()">Fechar</button></div>`);return;}
 const m=makeMon('Uhcakip',20);let where='time ativo';if(G.party.length<6)G.party.push(m);else{G.storage.push(m);where='Armazenamento';}save();sfx('ok');
 overlay(`<div class="modal"><h3>✨ Monstrinho secreto!</h3>${img(SECRET)}<p>Você recebeu o monstrinho secreto <b>nº 11, Uhcakip</b> (Elétrico, Nv.20)!</p><p class="mini">Enviado para: ${where}.</p><button class="btn green" onclick="dexScreen()">Continuar</button></div>`);}

/* ---- Aplicar temas às telas ---- */
const TH={titleScreen:'menu',chooseStarter:'menu',tutorial:'menu',hubScreen:'menu',typesScreen:'menu',renderBattle:'forest',careScreen:'care',dexScreen:'dex',storageScreen:'farm',shopScreen:'shop'};
Object.keys(TH).forEach(n=>{const o=window[n];window[n]=function(){CUR=TH[n];return o.apply(this,arguments);};});
titleScreen();

</script>
